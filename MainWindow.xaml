<Window x:Class="PushToText.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PushToText"
        Width="620"
        Height="460"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/tape.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ForegroundPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="RecordingLight"
                         Width="12"
                         Height="12"
                         Margin="0,0,6,0"
                         Fill="{StaticResource AccentBrush}"
                         Opacity="0.2" />
                <Ellipse x:Name="StatusIndicator"
                         Width="12"
                         Height="12"
                         Margin="0,0,8,0"
                         Fill="{StaticResource MutedBrush}" />
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Ready" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="MinimizeToTrayButton"
                        Width="26"
                        Height="26"
                        Margin="0,0,6,0"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="{StaticResource ForegroundPrimaryBrush}"
                        Click="MinimizeToTrayButton_OnClick">
                    <Button.ToolTip>
                        <ToolTip Background="White" Foreground="Black">
                            <TextBlock Foreground="Black" Text="Minimize to tray" />
                        </ToolTip>
                    </Button.ToolTip>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Circle"
                                         Fill="{StaticResource SurfaceBackgroundBrush}"
                                         Stroke="{StaticResource BorderBrush}"
                                         StrokeThickness="1" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Text="_"
                                           Margin="0,0,0,4"
                                           Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Circle" Property="Fill" Value="{StaticResource ElevatedBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Circle" Property="Fill" Value="{StaticResource ElevatedBackgroundBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <ToggleButton x:Name="OptionsToggleButton"
                              Width="26"
                              Height="26"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              BorderThickness="0"
                              Background="Transparent"
                              Foreground="{StaticResource ForegroundPrimaryBrush}">
                    <ToggleButton.ToolTip>
                        <ToolTip Background="White" Foreground="Black">
                            <TextBlock Foreground="Black" Text="Options" />
                        </ToolTip>
                    </ToggleButton.ToolTip>
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Ellipse x:Name="Circle"
                                         Fill="{StaticResource SurfaceBackgroundBrush}"
                                         Stroke="{StaticResource BorderBrush}"
                                         StrokeThickness="1" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Text="⋯"
                                           Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Circle" Property="Fill" Value="{StaticResource ElevatedBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Circle" Property="Fill" Value="{StaticResource ElevatedBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Circle" Property="Fill" Value="{StaticResource ElevatedBackgroundBrush}" />
                                    <Setter TargetName="Circle" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=OptionsToggleButton}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Margin="6,4,6,6">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Mode:" />
                    <ComboBox x:Name="RecordingModeComboBox"
                              Width="110"
                              SelectionChanged="RecordingModeComboBox_OnSelectionChanged">
                        <ComboBoxItem Tag="Push" Content="Push" />
                        <ComboBoxItem Tag="Toggle" Content="Toggle" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Audio input:" />
                    <ComboBox x:Name="AudioInputComboBox"
                              Width="420"
                              SelectionChanged="AudioInputComboBox_OnSelectionChanged"
                              DisplayMemberPath="Name" />
                    <Button x:Name="RefreshAudioDevicesButton"
                            Margin="8,0,0,0"
                            Width="28"
                            Height="24"
                            Padding="0"
                            ToolTip="Refresh audio devices"
                            Content="↻"
                            Click="RefreshAudioDevicesButton_OnClick" />
                </StackPanel>

                <CheckBox x:Name="AutoCopyCheckBox"
                          Margin="0,0,0,8"
                          Content="Auto copy after transcription"
                          Checked="AutoCopyCheckBox_OnCheckedChanged"
                          Unchecked="AutoCopyCheckBox_OnCheckedChanged" />

                <GroupBox Header="Hotkey Customization">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Record hotkey:" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <CheckBox x:Name="MicCtrlCheckBox" Content="Ctrl" Margin="0,0,8,0" />
                            <CheckBox x:Name="MicShiftCheckBox" Content="Shift" Margin="0,0,8,0" />
                            <CheckBox x:Name="MicAltCheckBox" Content="Alt" Margin="0,0,8,0" />
                            <CheckBox x:Name="MicWinCheckBox" Content="Win" Margin="0,0,8,0" />
                            <ComboBox x:Name="MicKeyComboBox" Width="120" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,0" Text="Copy hotkey:" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox x:Name="CopyCtrlCheckBox" Content="Ctrl" Margin="0,0,8,0" />
                            <CheckBox x:Name="CopyShiftCheckBox" Content="Shift" Margin="0,0,8,0" />
                            <CheckBox x:Name="CopyAltCheckBox" Content="Alt" Margin="0,0,8,0" />
                            <CheckBox x:Name="CopyWinCheckBox" Content="Win" Margin="0,0,8,0" />
                            <ComboBox x:Name="CopyKeyComboBox" Width="120" />
                        </StackPanel>

                        <Button Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Padding="10,4"
                                Content="Apply Hotkeys"
                                Click="ApplyHotkeysButton_OnClick" />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   x:Name="HotkeyTextBlock"
                   Margin="0,2,0,8"
                   Foreground="{StaticResource SecondaryBrush}"
                   Text="" />

        <TextBox Grid.Row="3"
                 x:Name="TranscriptTextBox"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 PreviewMouseDown="TranscriptTextBox_OnPreviewMouseDown"
                 LostKeyboardFocus="TranscriptTextBox_OnLostKeyboardFocus" />

        <TextBlock Grid.Row="4"
                   x:Name="ErrorTextBlock"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource ErrorBrush}"
                   Text="" />
    </Grid>
</Window>
